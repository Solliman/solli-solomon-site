<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Solli Solomon — Avatar Studio (Teal & Gold)</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>
    * { box-sizing: border-box; }
    body { background: #07090b; color: #fff; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; }
    
    .panel { background: #12171a; padding: 25px; border: 1px solid #2a343b; text-align: center; margin-bottom: 30px; z-index: 100; display: flex; flex-direction: column; gap: 15px; border-radius: 8px;}
    
    .input-group { display: flex; flex-direction: column; gap: 8px; text-align: left; }
    .input-group label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: #8c9ea8; font-family: 'DM Mono', monospace;}
    .input-group select { background: #0c0f12; border: 1px solid #2a343b; color: #fff; padding: 12px; border-radius: 4px; font-family: 'DM Mono', monospace; outline: none; cursor: pointer; }

    .btn-row { display: flex; gap: 10px; justify-content: center; margin-top: 10px; }
    
    .btn { background: #00c8b4; color: #000; border: none; padding: 12px 20px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; border-radius: 4px; font-family: 'DM Mono', monospace; transition: 0.3s; font-size: 12px; }
    .btn:hover { background: #fff; }
    
    .btn-alt { background: transparent; color: #00c8b4; border: 1px solid #00c8b4; }
    .btn-alt:hover { background: #00c8b4; color: #000; }

    /* AVATAR GIGANTE DA SCARICARE (1000x1000) */
    .avatar-wrapper { width: 450px; height: 450px; position: relative; border-radius: 50%; box-shadow: 0 20px 50px rgba(0,0,0,0.8); border: 1px solid #2a343b; overflow: hidden; transition: 0.3s; }
    
    /* Quando va in modalità screenshot puro */
    .avatar-wrapper.full-mode { width: 1000px; height: 1000px; border-radius: 0; border: none; position: fixed; top: 0; left: 50%; transform: translateX(-50%); z-index: 9999; }
    .close-full { display: none; position: fixed; top: 20px; right: 20px; z-index: 10000; background: #fff; color: #000; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; font-family: 'DM Mono', monospace; }

    .avatar { width: 1000px; height: 1000px; position: absolute; top: 0; left: 0; transform: scale(0.45); transform-origin: top left; background-color: #07090b; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: 0.3s; }
    .avatar-wrapper.full-mode .avatar { transform: scale(1); }

    /* LA TUA FOTO */
    .bg-image { position: absolute; inset: 0; background-image: url('solli-artist.jpg'); background-size: cover; background-position: center 20%; filter: grayscale(100%) contrast(1.2); }
    
    /* LIVELLI BASE (Filtro, Vignetta, Rumore) */
    .bg-overlay { position: absolute; inset: 0; mix-blend-mode: multiply; z-index: 2; transition: 0.5s;}
    .vignette { position: absolute; inset: 0; background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0,0.8) 100%); z-index: 3;}
    .noise { position: absolute; inset: 0; opacity: 0.35; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.2'/%3E%3C/svg%3E"); pointer-events: none; z-index: 4;}

    /* TESTI */
    .content { position: relative; z-index: 10; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .artist-name { font-family: 'DM Mono', monospace; font-size: 32px; letter-spacing: 0.6em; color: #fff; text-transform: uppercase; margin-bottom: 20px; opacity: 0.8; }
    .group-name { font-family: 'Cormorant Garamond', serif; font-size: 160px; font-weight: 300; font-style: italic; color: #fff; line-height: 1; margin-bottom: 15px; transition: 0.5s; }
    .group-label { font-family: 'DM Mono', monospace; font-size: 24px; letter-spacing: 0.3em; text-transform: uppercase; background: rgba(0,0,0,0.5); padding: 8px 20px; border: 1px solid; backdrop-filter: blur(5px); transition: 0.5s;}

    /* TEMA 1: DEEP TEAL (Originale del sito) */
    .theme-teal .bg-overlay { background: #071a18; }
    .theme-teal .group-name { color: #f5c74f; text-shadow: 0 10px 40px rgba(0,0,0,0.8), 0 0 30px rgba(245, 199, 79, 0.3); }
    .theme-teal .group-label { color: #00c8b4; border-color: rgba(0,200,180,0.3); }

    /* TEMA 2: GIALLO ORO */
    .theme-gold .bg-overlay { background: #3d2c0b; } /* Oro scuro per non bruciare la foto */
    .theme-gold .group-name { color: #f5c74f; text-shadow: 0 10px 40px rgba(0,0,0,0.8), 0 0 30px rgba(245, 199, 79, 0.5); }
    .theme-gold .group-label { color: #f5c74f; border-color: rgba(245, 199, 79, 0.4); }

</style>
</head>
<body>

    <!-- Pulsante per uscire dalla modalità schermo intero -->
    <div class="close-full" id="close-full" onclick="toggleFullMode()">CHIUDI ANTEPRIMA</div>

    <div class="panel" id="control-panel">
        <div class="input-group">
            <label>Seleziona Stile Sfondo</label>
            <select id="ctrl-theme">
                <option value="theme-teal">Deep Teal (Originale Sito)</option>
                <option value="theme-gold">Giallo Oro (Elegante)</option>
            </select>
        </div>
        
        <div class="btn-row">
            <button class="btn" id="btn-dl" onclick="downloadAvatar()">⬇ Scarica (Script)</button>
            <button class="btn btn-alt" onclick="toggleFullMode()">👁 Mostra 1000x1000</button>
        </div>
        <p style="font-size:10px; color:#6c7e88; max-width: 300px; font-family: 'DM Mono', monospace; margin: 0 auto;">
            Se il browser blocca il "Scarica", clicca su "Mostra 1000x1000" e usa lo strumento Cattura Schermo / Screenshot.
        </p>
    </div>

    <div class="avatar-wrapper" id="wrapper">
        <div class="avatar theme-teal" id="artwork">
            <div class="bg-image"></div>
            <div class="bg-overlay"></div>
            <div class="vignette"></div>
            <div class="noise"></div>
            
            <div class="content">
                <div class="artist-name">SOLLI SOLOMON</div>
                <div class="group-name">Il Cenacolo</div>
                <div class="group-label">Private Inner Circle</div>
            </div>
        </div>
    </div>

    <script>
        // Gestione Cambio Colore (Teal vs Oro)
        const themeInput = document.getElementById('ctrl-theme');
        const artwork = document.getElementById('artwork');
        
        themeInput.addEventListener('change', (e) => {
            artwork.className = `avatar ${e.target.value}`;
        });

        // Script di Download classico
        function downloadAvatar() {
            const btnDl = document.getElementById('btn-dl');
            btnDl.innerText = "⏳ ATTENDI...";
            
            html2canvas(document.getElementById('artwork'), { scale: 1, backgroundColor: null, useCORS: true }).then(canvas => {
                const link = document.createElement('a');
                link.download = `Avatar-Cenacolo.png`;
                link.href = canvas.toDataURL('image/png', 1.0);
                link.click();
                btnDl.innerText = "✓ SCARICATA!";
                setTimeout(() => { btnDl.innerText = "⬇ Scarica (Script)"; }, 3000);
            }).catch(err => {
                alert("Il browser ha bloccato il download. Usa il pulsante 'Mostra 1000x1000' e fai uno screenshot!");
                btnDl.innerText = "ERRORE BROWSER";
            });
        }

        // Funzione Infallibile: Apre l'immagine a 1000x1000px per fare lo Screenshot
        function toggleFullMode() {
            const wrapper = document.getElementById('wrapper');
            const closeBtn = document.getElementById('close-full');
            const panel = document.getElementById('control-panel');

            if(wrapper.classList.contains('full-mode')) {
                wrapper.classList.remove('full-mode');
                closeBtn.style.display = 'none';
                panel.style.display = 'flex';
                document.body.style.background = '#07090b';
            } else {
                wrapper.classList.add('full-mode');
                closeBtn.style.display = 'block';
                panel.style.display = 'none';
                document.body.style.background = '#000';
            }
        }
    </script>
</body>
</html>
